rules_version = '2';
// RASCUNHO revisado: testar no Emulator antes de publicar.
//
// Toda gravação em `notas` precisa vir junto (transação/batch) com um documento novo
// em `eventos`. O front gera o ID do evento antes (doc(collection(db, 'eventos')).id)
// e grava esse ID em `notas/{chave}.ultimoEventoId`.
// Exclusão: o evento usa o ID `${ultimoEventoId}_exclusao`, porque no delete não há
// request.resource para apontar o evento.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Papéis ----------
    function logado() { return request.auth != null; }
    function papel() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel;
    }
    function ehAdmin() { return logado() && papel() == 'admin'; }
    function ehOperador() { return logado() && papel() in ['admin', 'operador']; }
    function podeLer() { return logado() && papel() in ['admin', 'operador', 'tv']; }

    function caminhoEvento(id) { return /databases/$(database)/documents/eventos/$(id); }
    function caminhoNota(chave) { return /databases/$(database)/documents/notas/$(chave); }

    // ---------- Notas ----------
    function formatoChave(chave) {
      // 6 dígitos (UF + AAMM), 12 alfanuméricos (raiz + ordem do CNPJ), 26 dígitos.
      return chave.matches('^[0-9]{6}[0-9A-Z]{12}[0-9]{26}$');
    }

    function camposObrigatoriosNota() {
      return ['uf', 'aamm', 'cnpjEmitente', 'modelo', 'serie', 'numero', 'tpEmis',
              'codigoNumerico', 'status', 'recebidaEm', 'recebidaPor', 'ultimoEventoId'];
    }

    // Os campos têm o formato certo e, juntos, formam a própria chave (o ID do documento).
    function camposNotaBatemComChave(chave, d) {
      return d.uf.matches('^[0-9]{2}$')
        && d.aamm.matches('^[0-9]{4}$')
        && d.cnpjEmitente.matches('^[0-9A-Z]{12}[0-9]{2}$')
        && d.modelo == '55'
        && d.serie.matches('^[0-9]{3}$')
        && d.numero.matches('^[0-9]{9}$')
        && d.tpEmis.matches('^[0-9]$')
        && d.codigoNumerico.matches('^[0-9]{8}$')
        && chave.matches('^' + d.uf + d.aamm + d.cnpjEmitente + d.modelo + d.serie
             + d.numero + d.tpEmis + d.codigoNumerico + '[0-9]$');
    }

    // O evento apontado por ultimoEventoId é novo nesta gravação e descreve esta ação.
    function eventoNovo(chave, tipo) {
      let id = request.resource.data.ultimoEventoId;
      let ev = getAfter(caminhoEvento(id)).data;
      return id is string
        && !exists(caminhoEvento(id))
        && ev.chave == chave
        && ev.tipo == tipo
        && ev.usuario == request.auth.uid;
    }

    function alteraSo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function saida(chave) {
      let d = request.resource.data;
      return resource.data.status == 'preparacao'
        && d.status == 'em_rota'
        && d.saidaEm == request.time
        && d.saidaPor == request.auth.uid
        && alteraSo(['status', 'saidaEm', 'saidaPor', 'ultimoEventoId'])
        && eventoNovo(chave, 'saida');
    }

    // Estorno da saída: em_rota -> preparacao, removendo saidaEm/saidaPor.
    function estorno(chave) {
      let d = request.resource.data;
      return resource.data.status == 'em_rota'
        && d.status == 'preparacao'
        && !('saidaEm' in d)
        && !('saidaPor' in d)
        && alteraSo(['status', 'saidaEm', 'saidaPor', 'ultimoEventoId'])
        && eventoNovo(chave, 'estorno');
    }

    function eventoExclusao(chave) {
      let id = resource.data.ultimoEventoId + '_exclusao';
      let ev = getAfter(caminhoEvento(id)).data;
      return !exists(caminhoEvento(id))
        && ev.chave == chave
        && ev.tipo == 'exclusao'
        && ev.usuario == request.auth.uid;
    }

    match /notas/{chave} {
      allow read: if podeLer();

      // Entrada: cria em preparacao, com o próprio uid e a hora do servidor.
      allow create: if ehOperador()
        && formatoChave(chave)
        && request.resource.data.keys().hasAll(camposObrigatoriosNota())
        && request.resource.data.keys().hasOnly(camposObrigatoriosNota())
        && camposNotaBatemComChave(chave, request.resource.data)
        && request.resource.data.status == 'preparacao'
        && request.resource.data.recebidaPor == request.auth.uid
        && request.resource.data.recebidaEm == request.time
        && eventoNovo(chave, 'entrada');

      // Saída: operador ou admin. Estorno: só admin.
      allow update: if ehOperador() && (saida(chave) || (ehAdmin() && estorno(chave)));

      allow delete: if ehAdmin() && eventoExclusao(chave);
    }

    // ---------- Eventos (histórico imutável) ----------
    function camposEventoValidos(d) {
      return d.keys().hasAll(['chave', 'tipo', 'usuario', 'aparelho', 'criadoEm'])
        && d.keys().hasOnly(['chave', 'tipo', 'usuario', 'aparelho', 'detalhe', 'criadoEm'])
        && d.chave is string && formatoChave(d.chave)
        && d.usuario == request.auth.uid
        && d.aparelho is string && d.aparelho.size() > 0 && d.aparelho.size() <= 64
        && (!('detalhe' in d) || (d.detalhe is string && d.detalhe.size() <= 500))
        && d.criadoEm == request.time;
    }

    match /eventos/{id} {
      allow read: if ehOperador();

      // Cada branch testa o tipo primeiro, para só consultar a nota no caso certo.
      allow create: if ehOperador()
        && camposEventoValidos(request.resource.data)
        && (
          // Entrada/saída/estorno: a nota gravada junto aponta para este evento.
          (request.resource.data.tipo in ['entrada', 'saida']
            && getAfter(caminhoNota(request.resource.data.chave)).data.ultimoEventoId == id)
          || (request.resource.data.tipo == 'estorno' && ehAdmin()
            && getAfter(caminhoNota(request.resource.data.chave)).data.ultimoEventoId == id)
          // Exclusão: a nota existia, some nesta gravação, e o ID segue a convenção.
          || (request.resource.data.tipo == 'exclusao' && ehAdmin()
            && id == get(caminhoNota(request.resource.data.chave)).data.ultimoEventoId + '_exclusao'
            && !existsAfter(caminhoNota(request.resource.data.chave)))
        );

      allow update, delete: if false;
    }

    // ---------- Emitentes (cache da BrasilAPI) ----------
    function camposEmitenteValidos(d) {
      return d.keys().hasAll(['razaoSocial', 'consultadoEm'])
        && d.keys().hasOnly(['razaoSocial', 'nomeFantasia', 'consultadoEm'])
        && d.razaoSocial is string && d.razaoSocial.size() > 0 && d.razaoSocial.size() <= 200
        && (!('nomeFantasia' in d) || d.nomeFantasia == null
            || (d.nomeFantasia is string && d.nomeFantasia.size() <= 200))
        && d.consultadoEm == request.time;
    }

    match /emitentes/{cnpj} {
      allow read: if podeLer();
      allow create, update: if ehOperador()
        && cnpj.matches('^[0-9A-Z]{12}[0-9]{2}$')
        && camposEmitenteValidos(request.resource.data);
      allow delete: if ehAdmin();
    }

    // ---------- Configuração ----------
    match /config/{doc} {
      allow read: if podeLer();
      allow write: if ehAdmin()
        && doc == 'geral'
        && request.resource.data.keys().hasOnly(['diasUrgencia', 'horasEmRotaNaTv'])
        && request.resource.data.diasUrgencia is int
        && request.resource.data.diasUrgencia >= 1 && request.resource.data.diasUrgencia <= 60
        && request.resource.data.horasEmRotaNaTv is int
        && request.resource.data.horasEmRotaNaTv >= 1 && request.resource.data.horasEmRotaNaTv <= 168;
    }

    // ---------- Usuários ----------
    // O primeiro admin é criado à mão no console do Firebase.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow delete: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'papel'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0
        && request.resource.data.papel in ['admin', 'operador', 'tv'];
    }
  }
}
