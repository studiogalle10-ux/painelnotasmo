# Copie para .env.local e preencha com a configuração do app web
# (console do Firebase > Configurações do projeto > Seus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Em `npm run dev` o app usa o Emulator. Coloque false para usar o projeto real.
VITE_USAR_EMULADOR=true
